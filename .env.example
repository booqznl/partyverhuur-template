# ============================================================================
# ENVIRONMENT VARIABELEN — voorbeeld
# ----------------------------------------------------------------------------
# Kopieer deze 8 regels naar Vercel (Settings -> Environment Variables) en
# vul de echte waarden in VOORDAT je Deploy indrukt. Zie NIEUWE_SITE.md fase 6.
#
# Dit .env.example-bestand bevat GEEN echte sleutels en mag in de repo staan.
# Zet NOOIT een ingevuld .env-bestand met echte keys in git.
# ============================================================================

# --- Supabase -----------------------------------------------------------
# Te vinden in Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECTREF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLAK_ANON_KEY

# service_role is GEHEIM. Beide variabelen krijgen dezelfde waarde.
SUPABASE_SERVICE_ROLE_KEY=PLAK_SERVICE_ROLE_KEY
SUPABASE_SERVICE_KEY=PLAK_SERVICE_ROLE_KEY

# --- E-mail (Resend) ----------------------------------------------------
# Begin met 'dummy'; vervang door de echte key vóór livegang (fase 10).
RESEND_API_KEY=dummy

# --- Betaling (Mollie) --------------------------------------------------
# Begin met 'dummy'; vervang door de echte key vóór livegang (fase 10).
MOLLIE_API_KEY=dummy

# --- Cron-beveiliging ---------------------------------------------------
# Genereer een NIEUWE, unieke willekeurige string per site.
# Nooit hergebruiken tussen klanten.
CRON_SECRET=GENEREER_UNIEKE_STRING

# --- Site-URL -----------------------------------------------------------
# Het uiteindelijke publieke adres, met https en www.
NEXT_PUBLIC_SITE_URL=https://www.VULIN.nl
